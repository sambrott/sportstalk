# Get a key at https://console.anthropic.com/ — never commit the real .env
# The Vite dev server injects this server-side for POST /api/anthropic
ANTHROPIC_API_KEY=

# Optional model override (default: claude-sonnet-4-5-20250929 in code)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Production: if you add a same-origin proxy, set the base (otherwise the app uses rules-based replies)
# VITE_ANTHROPIC_PROXY_BASE=https://your-app.example.com/api/anthropic
